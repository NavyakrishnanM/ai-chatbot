# ============================================
# DevAssist - .gitignore
# ============================================

# --- Environment files (NEVER commit these) ---
.env
.env.*
*.env
!.env.example

# --- Angular (frontend) ---
frontend/node_modules/
frontend/.angular/
frontend/dist/

# --- Spring Boot (backend) ---
backend/target/
backend/*.jar
backend/*.war

# --- Python (ai-service) ---
ai-service/__pycache__/
ai-service/.venv/
ai-service/venv/
ai-service/*.pyc
ai-service/.pytest_cache/
**/__pycache__/
*.pyc
*.pyo

# --- IDE / Editor ---
.idea/
.vscode/
*.iml
*.suo
*.user

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
